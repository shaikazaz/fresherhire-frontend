# Copy to .env and edit.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# DB_ENGINE=mysql for the assessment. Use sqlite only for a quick smoke test.
DB_ENGINE=mysql
DB_NAME=jobportal
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Resume must reach this ATS score before it becomes your active resume (plan says 75).
ATS_PASS_SCORE=75
MAX_RESUME_MB=5

# Day 2 email (console backend is safe for local testing)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=FresherHire <no-reply@localhost>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Optional: HubSpot private app token. When set, every signup is synced to HubSpot.
HUBSPOT_ACCESS_TOKEN=
# Day 3 Razorpay test mode (never commit the secret)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ALLOW_DIRECT_ACTIVATION=False
SITE_URL=http://127.0.0.1:8000
